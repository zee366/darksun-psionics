<{{ elements.inventory }} class="inventory-element" v2 data-collection="powerbook">
  <item-list-controls for="powerbook" label="{{ localize "DSPSIONICS.PowersSearch" }}" collection="powerbook" keep-empty>
    <datalist>
      <option value="action">{{ localize "DND5E.Action" }}</option>
      <option value="bonus">{{ localize "DND5E.BonusAction" }}</option>
      <option value="reaction">{{ localize "DND5E.Reaction" }}</option>
    </datalist>
  </item-list-controls>
  <section class="items-list powers-list inventory-list" data-item-list="powerbook">
    {{#each powers as |section|}}
      {{#if (eq section.dataset.type "power")}}
        <div class="items-section card" data-type="power">
          <div class="items-header header">
            <h3 class="item-name power-header">{{ localize section.label }}</h3>
            <div class="item-header item-level">{{ localize "DND5E.Level" }}</div>
            <div class="item-header item-controls"></div>
          </div>
          <ol class="item-list unlist">
            {{#each section.items as |item|}}
              <li class="item flexrow" data-item-id="{{ item._id }}">
                <div class="item-name">{{ item.name }}</div>
                <div class="item-detail item-level">{{ item.system.level }}</div>
                {{#if @root.editable}}
                  <div class="item-detail item-controls">
                    <a class="item-control item-action" data-action="edit" data-tooltip="DND5E.ItemEdit">
                      <i class="fas fa-pen-to-square"></i>
                    </a>
                    <a class="item-control item-action" data-action="delete" data-tooltip="DND5E.ItemDelete">
                      <i class="fas fa-trash"></i>
                    </a>
                  </div>
                {{/if}}
              </li>
            {{/each}}
          </ol>
        </div>
      {{/if}}
    {{/each}}
  </section>
</{{ elements.inventory }}>