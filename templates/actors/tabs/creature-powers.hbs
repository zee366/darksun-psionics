{{!-- Powers --}}
<{{ elements.inventory }} class="inventory-element" v2 data-collection="powerbook">

  <item-list-controls for="powerbook" label="{{ localize "DSPSIONICS.PowersSearch" }}" collection="powerbook" keep-empty>
    <datalist>
      <option value="action">{{ localize "DND5E.Action" }}</option>
      <option value="bonus">{{ localize "DND5E.BonusAction" }}</option>
      <option value="reaction">{{ localize "DND5E.Reaction" }}</option>
    </datalist>
  </item-list-controls>

  {{!-- Powers List --}}
  <section class="items-list powers-list" data-item-list="powerbook">
      {{#each powers}}
      <div class="items-section card" {{ dnd5e-dataset dataset }}>
          {{!-- Section Header --}}
          <div class="items-header header">
              <h3 class="item-name power-header">{{ localize label }}</h3>
              <div class="item-header item-activation">{{ localize "DND5E.SpellHeader.Time" }}</div>
              <div class="item-header item-range">{{ localize "DND5E.SpellHeader.Range" }}</div>
              <div class="item-header item-target">{{ localize "DND5E.SpellHeader.Target" }}</div>
              <div class="item-header item-roll">{{ localize "DND5E.SpellHeader.Roll" }}</div>
              <div class="item-header item-cost">{{ localize "DSPSIONICS.PowerCost" }}</div>
              <div class="item-header item-controls"></div>
          </div>

          {{!-- Section Contents --}}
          <ol class="item-list unlist">
              {{#each items as |item|}}
              {{#dnd5e-itemContext item as |ctx|}}

              {{!-- Power Item --}}
              <li class="item collapsible {{#unless ctx.isExpanded}}collapsed{{/unless}}" 
                  data-item-id="{{ item.id }}" 
                  data-entry-id="{{ item.id }}" 
                  data-uuid="{{ item.uuid }}" 
                  {{ dnd5e-dataset ctx.dataset }}>

                  <div class="item-row">
                      {{!-- Power Name --}}
                      <div class="item-name item-action item-tooltip {{ @root.rollableClass }}" 
                          role="button" 
                          data-action="use" 
                          aria-label="{{ item.name }}">
                          <img class="item-image gold-icon" src="{{ item.img }}" alt="{{ item.name }}" draggable="false">
                          <div class="name name-stacked">
                              <span class="title">{{ item.name }}</span>
                              <span class="subtitle">
                                  {{{ ctx.subtitle }}}
                              </span>
                          </div>
                      </div>

                      {{!-- Activation Time --}}
                      <div class="item-detail item-activation">
                          <span class="condensed">{{ ctx.activation }}</span>
                      </div>

                      {{!-- Range --}}
                      <div class="item-detail item-range {{#unless ctx.range}}empty{{/unless}}">
                          {{#if ctx.range}}
                          {{#if ctx.range.distance}}
                          {{{ ctx.range.parts }}}
                          {{else}}
                          <span class="condensed">{{ item.labels.range }}</span>
                          {{/if}}
                          {{/if}}
                      </div>

                      {{!-- Target --}}
                      <div class="item-detail item-target {{#unless item.labels.target}}empty{{/unless}}">
                          {{#if item.labels.target}}
                          <span class="condensed">{{ item.labels.target }}</span>
                          {{/if}}
                      </div>

                      {{!-- Save DC --}}
                      <div class="item-detail item-save {{#unless ctx.save.ability}}empty{{/unless}}">
                          {{#if ctx.save.ability}}
                          <div class="stacked">
                              <span class="ability">{{ ctx.save.ability }}</span>
                              <span class="value">{{ ctx.save.dc.value }}</span>
                          </div>
                          {{/if}}
                      </div>

                      {{!-- Power Cost --}}
                      <div class="item-detail item-cost">
                          <span class="value">{{ item.system.powerCost }}</span>
                      </div>

                      {{!-- Controls --}}
                      <div class="item-detail item-controls">
                          {{#if @root.editable}}
                          {{!-- Edit --}}
                          <a class="item-control item-action" 
                            data-action="edit" 
                            data-tooltip="DND5E.ItemEdit" 
                            aria-label="{{ localize "DND5E.ItemEdit" }}">
                              <i class="fas fa-pen-to-square"></i>
                          </a>

                          {{!-- Delete --}}
                          {{#if item.canDelete}}
                          <a class="item-control item-action" 
                            data-action="delete" 
                            data-tooltip="DND5E.ItemDelete" 
                            aria-label="{{ localize "DND5E.ItemDelete" }}">
                              <i class="fas fa-trash"></i>
                          </a>
                          {{/if}}
                          {{/if}}

                          {{!-- Expand/Collapse --}}
                          <a class="item-control interface-only" 
                            data-toggle-description 
                            aria-label="{{ localize "DND5E.ToggleDescription" }}">
                              {{#if ctx.isExpanded}}
                              <i class="fas fa-compress"></i>
                              {{else}}
                              <i class="fas fa-expand"></i>
                              {{/if}}
                          </a>

                          {{!-- Context Menu --}}
                          <a class="item-control interface-only" 
                            data-context-menu 
                            aria-label="{{ localize "DND5E.AdditionalControls" }}">
                              <i class="fas fa-ellipsis-vertical"></i>
                          </a>
                      </div>
                  </div>

                  {{!-- Description --}}
                  <div class="item-description collapsible-content">
                      <div class="wrapper">
                          {{#if ctx.isExpanded}}
                          {{> "dnd5e.item-summary" ctx.expanded }}
                          {{/if}}
                      </div>
                  </div>

              </li>

              {{/dnd5e-itemContext}}
              {{/each}}
          </ol>
      </div>
      {{/each}}
  </section>
</{{ elements.inventory }}>